{
  "name": "rackles.io",
  "description": "Personal website of John Rackles",
  "engines": {
    "node": ">=15.0.0"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "vite-node ./src/generate-pdf.tsx",
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "wrangler pages deploy ./dist",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "lint": "biome lint",
    "preview": "qwik build preview && vite preview --open",
    "serve": "wrangler pages dev ./dist",
    "start": "vite --open --mode ssr",
    "test": "npm run prebuild && npm run build.client && npm run build.preview && node ./scripts/smoke-test.mjs",
    "test.smoke": "node ./scripts/smoke-test.mjs",
    "test.e2e": "npm run build.client && npm run build.preview && playwright test",
    "qwik": "qwik",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.4",
    "daisyui": "^5.7.7",
    "ignore": "^5.3.2",
    "lefthook": "^2.1.10",
    "node-addon-api": "^8.9.0",
    "node-gyp": "^12.4.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "undici": "^8.9.0",
    "vite": "^7.3.6",
    "vite-node": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "@builder.io/qwik-react": "^0.5.8",
    "@fontsource-variable/recursive": "^5.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.1"
  },
  "volta": {
    "node": "24"
  }
}
