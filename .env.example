# Used by the Node-based preview server (`npm run preview`, src/entry.preview.tsx)
# to resolve relative URLs and validate the request origin for CSRF checks.
# See https://qwik.dev/docs/deployments/#origin
#
# Not needed for the Cloudflare Pages production deployment -- Cloudflare's
# platform always provides an absolute request.url to derive the origin from.
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
ORIGIN=https://rackles.io
